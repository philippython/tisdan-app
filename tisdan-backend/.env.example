# Copy to .env and fill in. Never commit the real .env.

# local | staging | production  (non-local requires SECRET_KEY and BOT_API_KEY)
ENVIRONMENT=local
PROJECT_NAME=tisdan-api-v1

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# Database: SQLite file next to this .env by default...
SQLITE_DB_NAME=tisdan.db
# ...or a full URL, e.g. an absolute SQLite path outside the repo or Postgres:
# DATABASE_URL=sqlite:////var/lib/tisdan/tisdan.db
# DATABASE_URL=postgresql+psycopg://tisdan:password@localhost:5432/tisdan

# Admin portal URL(s) allowed to call this API (CORS)
FRONTEND_HOST=http://localhost:5173
# BACKEND_CORS_ORIGINS=https://admin.example.com,https://www.example.com

# WhatsApp bot service + shared secret (must match the bot's BOT_API_KEY)
TISDAN_BOT_URL=http://127.0.0.1:8001
BOT_API_KEY=change-me-too

# Paystack (optional — payment links are skipped when unset)
# PAYSTACK_SECRET_KEY=sk_live_xxx
