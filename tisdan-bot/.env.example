# Copy to .env and fill in. Never commit the real .env.

# Backend API base URL. If unset the bot runs on built-in DEMO data.
API_BASE=http://127.0.0.1:8002

# Shared secret — must match BOT_API_KEY in tisdan-backend/.env
BOT_API_KEY=change-me-too

# Twilio (Console → Account → API keys & tokens)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
# Your WhatsApp sender. The default is Twilio's shared sandbox number.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Public URL Twilio posts to. When set, webhook signatures are verified.
# TWILIO_WEBHOOK_URL=https://bot.example.com/sms
